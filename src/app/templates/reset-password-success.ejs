<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>DoctorHub Password Changed</title>
</head>

<body
	style="
		margin: 0;
		padding: 0;
		background-color: #f3f7fb;
		font-family: Arial, Helvetica, sans-serif;
		color: #172033;
	"
>
	<table
		role="presentation"
		width="100%"
		cellspacing="0"
		cellpadding="0"
		border="0"
		style="
			width: 100%;
			background-color: #f3f7fb;
			padding: 40px 16px;
		"
	>
		<tr>
			<td align="center">

				<table
					role="presentation"
					width="600"
					cellspacing="0"
					cellpadding="0"
					border="0"
					style="
						width: 100%;
						max-width: 600px;
						background-color: #ffffff;
						border-radius: 18px;
						overflow: hidden;
						box-shadow: 0 12px 35px rgba(15, 51, 92, 0.08);
					"
				>

					<!-- Header -->
					<tr>
						<td
							style="
								background-color: #0f3d6e;
								padding: 34px 40px;
								text-align: center;
							"
						>
							<div
								style="
									font-size: 29px;
									font-weight: 700;
									color: #ffffff;
								"
							>
								Doctor<span style="color: #67e8f9;">Hub</span>
							</div>

							<p
								style="
									margin: 8px 0 0;
									font-size: 14px;
									color: #c7d9ec;
								"
							>
								Account Security Notification
							</p>
						</td>
					</tr>

					<!-- Intro -->
					<tr>
						<td style="padding: 42px 40px 20px;">

							<p
								style="
									margin: 0 0 12px;
									font-size: 15px;
									color: #6b7c93;
								"
							>
								Hello <strong><%= name %></strong>,
							</p>

							<h1
								style="
									margin: 0 0 16px;
									font-size: 28px;
									line-height: 36px;
									font-weight: 700;
									color: #102a43;
								"
							>
								Your password has been changed
							</h1>

							<p
								style="
									margin: 0;
									font-size: 16px;
									line-height: 26px;
									color: #52667a;
								"
							>
								This email confirms that your DoctorHub account
								password was successfully updated.
							</p>

						</td>
					</tr>

					<!-- Success Box -->
					<tr>
						<td style="padding: 12px 40px 28px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #ecfdf5;
									border: 1px solid #a7f3d0;
									border-radius: 14px;
								"
							>
								<tr>
									<td
										align="center"
										style="padding: 30px 20px;"
									>

										<div
											style="
												width: 54px;
												height: 54px;
												line-height: 54px;
												margin: 0 auto 14px;
												background-color: #059669;
												border-radius: 50%;
												color: #ffffff;
												font-size: 28px;
												font-weight: 700;
												text-align: center;
											"
										>
											✓
										</div>

										<p
											style="
												margin: 0 0 7px;
												font-size: 18px;
												font-weight: 700;
												color: #065f46;
											"
										>
											Password updated successfully
										</p>

										<p
											style="
												margin: 0;
												font-size: 14px;
												line-height: 22px;
												color: #047857;
											"
										>
											You can now sign in using your
											new password.
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<!-- Account -->
					<tr>
						<td style="padding: 0 40px 28px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #f8fafc;
									border-radius: 12px;
								"
							>
								<tr>
									<td style="padding: 18px 20px;">

										<p
											style="
												margin: 0 0 7px;
												font-size: 12px;
												font-weight: 700;
												letter-spacing: 1px;
												text-transform: uppercase;
												color: #91a3b5;
											"
										>
											Account
										</p>

										<p
											style="
												margin: 0;
												font-size: 14px;
												color: #334e68;
											"
										>
											<%= email %>
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<!-- Warning -->
					<tr>
						<td style="padding: 0 40px 30px;">

							<table
								role="presentation"
								width="100%"
								cellspacing="0"
								cellpadding="0"
								border="0"
								style="
									background-color: #fff7ed;
									border-left: 4px solid #f97316;
									border-radius: 8px;
								"
							>
								<tr>
									<td style="padding: 17px 18px;">

										<p
											style="
												margin: 0 0 6px;
												font-size: 14px;
												font-weight: 700;
												color: #9a3412;
											"
										>
											⚠️ Didn't change your password?
										</p>

										<p
											style="
												margin: 0;
												font-size: 13px;
												line-height: 21px;
												color: #9a3412;
											"
										>
											If you did not make this change,
											your account may be at risk.
											Reset your password immediately and
											contact DoctorHub support.
										</p>

									</td>
								</tr>
							</table>

						</td>
					</tr>

					<!-- Security Tips -->
					<tr>
						<td style="padding: 0 40px 40px;">

							<p
								style="
									margin: 0 0 12px;
									font-size: 14px;
									font-weight: 700;
									color: #17324d;
								"
							>
								🔐 Keep your account secure
							</p>

							<p
								style="
									margin: 0;
									font-size: 14px;
									line-height: 24px;
									color: #6b7c93;
								"
							>
								• Never share your password or OTP.<br />
								• Use a unique password for DoctorHub.<br />
								• Avoid reusing passwords from other services.<br />
								• Sign out from devices you no longer use.
							</p>

							<p
								style="
									margin: 28px 0 0;
									font-size: 14px;
									line-height: 22px;
									color: #52667a;
								"
							>
								Take care,<br />
								<strong style="color: #102a43;">
									The DoctorHub Team
								</strong>
							</p>

						</td>
					</tr>

					<!-- Footer -->
					<tr>
						<td
							style="
								background-color: #f8fafc;
								border-top: 1px solid #e1eaf2;
								padding: 24px 40px;
								text-align: center;
							"
						>
							<p
								style="
									margin: 0 0 6px;
									font-size: 12px;
									color: #91a3b5;
								"
							>
								This is an automated DoctorHub security
								notification. Please do not reply.
							</p>

							<p
								style="
									margin: 0;
									font-size: 12px;
									color: #91a3b5;
								"
							>
								© <%= year %> DoctorHub. All rights reserved.
							</p>
						</td>
					</tr>

				</table>

			</td>
		</tr>
	</table>
</body>
</html>