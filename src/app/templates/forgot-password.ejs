<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DoctorHub Password Reset</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f3f7fb;
      font-family: Arial, Helvetica, sans-serif;
      color: #172033;
    "
  >
    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      border="0"
      style="width: 100%; background-color: #f3f7fb; padding: 40px 16px"
    >
      <tr>
        <td align="center">
          <table
            role="presentation"
            width="600"
            cellspacing="0"
            cellpadding="0"
            border="0"
            style="
              width: 100%;
              max-width: 600px;
              background-color: #ffffff;
              border-radius: 18px;
              overflow: hidden;
              box-shadow: 0 12px 35px rgba(15, 51, 92, 0.08);
            "
          >
            <!-- Header -->
            <tr>
              <td
                style="
                  background-color: #0f3d6e;
                  padding: 34px 40px;
                  text-align: center;
                "
              >
                <div
                  style="
                    font-size: 29px;
                    font-weight: 700;
                    color: #ffffff;
                    letter-spacing: -0.5px;
                  "
                >
                  Doctor<span style="color: #67e8f9">Hub</span>
                </div>

                <p
                  style="
                    margin: 8px 0 0;
                    font-size: 14px;
                    line-height: 22px;
                    color: #c7d9ec;
                  "
                >
                  Your trusted digital healthcare platform
                </p>
              </td>
            </tr>

            <!-- Main Content -->
            <tr>
              <td style="padding: 42px 40px 20px">
                <p style="margin: 0 0 12px; font-size: 15px; color: #6b7c93">
                  Hello <strong><%= name %></strong>,
                </p>

                <h1
                  style="
                    margin: 0 0 16px;
                    font-size: 28px;
                    line-height: 36px;
                    font-weight: 700;
                    color: #102a43;
                  "
                >
                  Reset your password
                </h1>

                <p
                  style="
                    margin: 0;
                    font-size: 16px;
                    line-height: 26px;
                    color: #52667a;
                  "
                >
                  We received a request to reset the password for your DoctorHub
                  account. Use the verification code below to continue.
                </p>
              </td>
            </tr>

            <!-- OTP Box -->
            <tr>
              <td style="padding: 12px 40px 30px">
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    background-color: #eef8ff;
                    border: 1px solid #bae6fd;
                    border-radius: 14px;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 30px 20px">
                      <p
                        style="
                          margin: 0 0 12px;
                          font-size: 12px;
                          font-weight: 700;
                          letter-spacing: 1.5px;
                          text-transform: uppercase;
                          color: #0369a1;
                        "
                      >
                        Your verification code
                      </p>

                      <div
                        style="
                          font-size: 40px;
                          line-height: 50px;
                          font-weight: 700;
                          letter-spacing: 10px;
                          color: #0f3d6e;
                        "
                      >
                        <%= otp %>
                      </div>

                      <p
                        style="
                          margin: 12px 0 0;
                          font-size: 13px;
                          color: #0284c7;
                        "
                      >
                        This code expires in
                        <strong><%= expirationMinutes %> minutes</strong>.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Security Notice -->
            <tr>
              <td style="padding: 0 40px 30px">
                <table
                  role="presentation"
                  width="100%"
                  cellspacing="0"
                  cellpadding="0"
                  border="0"
                  style="
                    background-color: #f8fafc;
                    border-left: 4px solid #0ea5e9;
                    border-radius: 8px;
                  "
                >
                  <tr>
                    <td style="padding: 17px 18px">
                      <p
                        style="
                          margin: 0 0 6px;
                          font-size: 14px;
                          font-weight: 700;
                          color: #17324d;
                        "
                      >
                        🔐 Security notice
                      </p>

                      <p
                        style="
                          margin: 0;
                          font-size: 13px;
                          line-height: 21px;
                          color: #60758a;
                        "
                      >
                        Never share this verification code with anyone.
                        DoctorHub will never ask for your OTP or password over a
                        phone call or message.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Bottom Message -->
            <tr>
              <td style="padding: 0 40px 40px">
                <p
                  style="
                    margin: 0;
                    font-size: 14px;
                    line-height: 23px;
                    color: #6b7c93;
                  "
                >
                  If you did not request a password reset, you can safely ignore
                  this email. Your current password will remain unchanged.
                </p>

                <p
                  style="
                    margin: 28px 0 0;
                    font-size: 14px;
                    line-height: 22px;
                    color: #52667a;
                  "
                >
                  Take care,<br />
                  <strong style="color: #102a43"> The DoctorHub Team </strong>
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                style="
                  background-color: #f8fafc;
                  border-top: 1px solid #e1eaf2;
                  padding: 24px 40px;
                  text-align: center;
                "
              >
                <p
                  style="
                    margin: 0 0 6px;
                    font-size: 12px;
                    line-height: 18px;
                    color: #91a3b5;
                  "
                >
                  This is an automated security email. Please do not reply.
                </p>

                <p style="margin: 0; font-size: 12px; color: #91a3b5">
                  © <%= year %> DoctorHub. All rights reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
